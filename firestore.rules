rules_version = '2';

// CFP platform — Firestore security rules (spec §6).
//
// The rules below are the enforcement boundary, not the UI. The Firestore SDK
// queries straight from the browser, so anything the UI merely hides is still
// readable unless it is denied here.
//
// Tenancy is in the path, not in a field. Everything that belongs to one call
// for proposals lives under `cfps/{cfpId}/…`, so a cross-tenant read is not a
// forgotten `where` clause — it is a different path, and there is no path that
// spans two CFPs. Rules are not filters, and could not have saved us from the
// alternative.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    // Verified, not merely signed in.
    //
    // Google always verifies, so while it was the only provider this was the
    // same thing. Email sign-in is not: the link proves the mailbox, but the
    // same provider also allows email+password signup, which proves nothing —
    // and roles are granted by address. Without this, anyone could register a
    // colleague's address with a password and pick up their pending grant.
    // `get` rather than a plain lookup: a token without the claim at all is an
    // account that has not verified, and reading the property straight off the
    // map raises instead of answering false.
    function signedIn() {
      return request.auth != null && request.auth.token.get('email_verified', false) == true;
    }

    function uid() {
      return request.auth.uid;
    }

    // ------------------------------------------------------- tenant helpers
    //
    // Every one of these takes the cfpId from the path. `get()` is cached per
    // request, so naming the same document from six helpers costs one read.

    function cfp(cfpId) {
      return get(/databases/$(database)/documents/cfps/$(cfpId)).data;
    }

    // Reads the boolean, never the timestamp beside it. Asking whether
    // `archivedAt` is absent — with `keys().hasAny`, with `in`, or with
    // `get(k, null)` — is silently *true* for every document inside a `list`
    // rule, so a listing would keep serving archived CFPs while every
    // single-document check denied them. An always-present boolean has no
    // absent case to get wrong.
    function archived(cfpId) {
      return cfp(cfpId).archived == true;
    }

    // §6: "Deadline enforcement happens server-side, not by disabling the
    // submit button." request.time is the server's clock, not the client's.
    // An archived CFP is closed whatever its dates say — archiving is how an
    // organiser stops a round without having to edit the window.
    function cfpOpen(cfpId) {
      let c = cfp(cfpId);
      return c.paused == false
        && c.archived == false
        && request.time >= c.opensAt
        && request.time < c.closesAt;
    }

    function memberPath(cfpId) {
      return /databases/$(database)/documents/cfps/$(cfpId)/members/$(uid());
    }

    // Holding any role on this CFP. Anyone signed in may submit a talk, so
    // speakers need no membership at all.
    function isReviewer(cfpId) {
      return signedIn() && exists(memberPath(cfpId));
    }

    function roleOn(cfpId) {
      return get(memberPath(cfpId)).data.role;
    }

    // `owner` outranks `admin` everywhere admin is enough. The distinction only
    // matters for archiving, deleting and changing who owns the thing, and
    // those all go through callables rather than through these rules.
    function isAdmin(cfpId) {
      return isReviewer(cfpId) && roleOn(cfpId) in ['admin', 'owner'];
    }

    // ------------------------------------------------------------------ cfps

    match /cfps/{cfpId} {

      // Anyone, signed in or not. `private` means unlisted, not secret: the
      // whole point of it is that a link works. Hiding the document from
      // somebody holding its id would break the feature, not protect it.
      allow get: if true;

      // Listing is the public directory, so it is the one that has to be
      // narrow.
      //
      // A `list` rule is evaluated against the *query*, not against the
      // documents it would return — `resource.data` here holds only the fields
      // the query filters on, and naming any other raises. So this reads as a
      // requirement on the caller: a listing must carry
      // `where('visibility','==','public').where('archived','==',false)`, or it
      // is refused outright. Rules are not filters; this is how they make the
      // client bring one.
      //
      // The second clause is the same bargain for an owner finding their own,
      // including the private and archived: `where('ownerUids','array-contains',uid)`.
      allow list: if (resource.data.visibility == 'public'
                      && resource.data.archived == false)
        || (signedIn() && uid() in resource.data.ownerUids);

      // Created, renamed, archived and deleted through callables. A client that
      // could write here could make itself an owner, which is the root of every
      // other permission in this file.
      allow write: if false;

      // --------------------------------------------------------- membership

      // A member reads their own document to know they hold a role; seeing the
      // whole committee is an admin matter.
      match /members/{memberUid} {
        allow get: if signedIn() && (memberUid == uid() || isReviewer(cfpId));
        allow list: if isAdmin(cfpId);
        allow write: if false;
      }

      // Pending invitations, keyed by email because a role is assigned before
      // the person has ever signed in. Holds addresses, so admins only.
      match /roleGrants/{email} {
        allow get, list: if isAdmin(cfpId);
        allow write: if false;
      }

      // ------------------------------------------------------------- config

      // `confirmForm` is the set of questions an accepted speaker is about to
      // answer, so they have to be able to read it — but only once signed in,
      // since it says nothing useful to a stranger and may name sponsors or
      // logistics that are not public yet. `email` stays shut: it holds the key
      // hint and the templates, which reach an admin through a callable.
      //
      // `submissionForm` is the form itself — its categories, its formats, the
      // consents it asks for. Readable by anyone, signed in or not, because the
      // public page of a call describes what it is asking for and a stranger
      // deciding whether to submit is exactly who that is for.
      //
      // The submission window is not here. It lives on the CFP document, which
      // is public — the form has to render its own state before anyone signs in.
      match /config/{docId} {
        allow read: if docId == 'submissionForm'
          || (docId == 'confirmForm' && signedIn());
        allow write: if false;
      }

      // ----------------------------------------------------------- proposals

      match /proposals/{proposalId} {

        function isSpeakerOn(doc) {
          return signedIn() && uid() in doc.speakerIds;
        }

        // Rules are evaluated against every document a query returns, so an
        // applicant's `where('speakerIds', 'array-contains', uid)` lookup passes
        // while an unconstrained listing of the collection is denied on the
        // first foreign document.
        //
        // A draft was never handed to anybody. Someone may have typed "I am
        // burning out and want to talk about it" into a pitch and thought better
        // of sending it — the committee has no claim on that, so reviewers see a
        // proposal only once its author submitted it. Committee-side queries
        // must therefore carry `where('status', '!=', 'draft')`.
        allow get, list: if isSpeakerOn(resource.data)
          || (isReviewer(cfpId) && resource.data.status != 'draft');

        // Exactly the author, not "the author plus anyone they name".
        //
        // The field stays an array because co-presenters are in the data model
        // (§6), but naming someone is a claim about *them*: it hands them write
        // access to this document, and — since a speaker may not review their
        // own talk — silently disqualifies them from reviewing it. Neither
        // should be possible without their consent, so when co-presenters are
        // built they get an invitation callable and this rule relaxes to match.
        //
        // `cfpId` is pinned to the path. It is denormalised for the aggregate's
        // collection-group query, and a document claiming to belong to another
        // CFP would be counted into that CFP's scores.
        allow create: if signedIn()
          && cfpOpen(cfpId)
          && request.resource.data.speakerIds == [uid()]
          && request.resource.data.get('cfpId', '') == cfpId
          // The only status a client may ever write, and only at creation.
          && request.resource.data.status == 'draft'
          && !request.resource.data.keys().hasAny([
               'aggregate', 'submittedAt', 'confirmDeadline',
               'confirmedAt', 'assignedLanguage', 'speakerSnapshot'
             ]);

        // Keys the client may never write, on create or update. `status` and
        // `aggregate` are function-writable only; the rest are set during
        // selection and scheduling. `speakerSnapshot` is what the committee
        // read, so the person being judged is exactly the wrong author for it.
        function touchesProtected() {
          return request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'cfpId', 'status', 'aggregate', 'submittedAt', 'confirmDeadline',
            'confirmedAt', 'assignedLanguage', 'confirmAnswers', 'speakerSnapshot'
          ]);
        }

        // Nothing the committee has started reading may still be changing under
        // them. Before that point a submitted proposal is still the speaker's to
        // improve — the deadline is what closes it, not the act of submitting.
        function beforeReview() {
          return resource.data.status == 'draft' || resource.data.status == 'submitted';
        }

        // Alive, but being judged or already decided.
        function underConsideration() {
          return resource.data.status in ['under_review', 'accepted', 'confirmed', 'waitlisted'];
        }

        // Travel plans change for reasons that have nothing to do with the talk,
        // and they carry no weight in the score — so they stay editable after
        // the content freezes, and after the window closes.
        function onlyLogistics() {
          return request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['attendance', 'updatedAt']);
        }

        allow update: if signedIn()
          // Must already be a speaker on this proposal — prevents writing
          // yourself onto someone else's document.
          && isSpeakerOn(resource.data)
          // The cast is fixed once the document exists — see `create` above.
          && request.resource.data.speakerIds == resource.data.speakerIds
          // The draft -> submitted transition is done by the submitProposal
          // function, which runs with admin credentials and bypasses these rules.
          && !touchesProtected()
          && !archived(cfpId)
          && ((cfpOpen(cfpId) && beforeReview()) || (underConsideration() && onlyLogistics()));

        // Submitted work is withdrawn rather than deleted so email and review
        // history stays intact. The narrowly guarded deleteDraftProposal
        // callable is the only per-talk hard delete; clients never delete.
        allow delete: if false;

        // ----------------------------------------------------------- reviews
        //
        // §6: "Applicants must never be able to read the reviews subcollection."
        // Note there is no applicant clause anywhere in this block — the only
        // readers are reviewers, and only of their own document until the round
        // closes (§7, anchoring).
        match /reviews/{reviewerUid} {

          // Reviewers and admins may also submit talks, which puts them on both
          // sides of this subcollection. §6 says an applicant must never read
          // the reviews of their own proposal, and that outranks any role — so
          // this gate is applied to reads and writes alike, admins included.
          function proposal() {
            return get(/databases/$(database)/documents/cfps/$(cfpId)/proposals/$(proposalId)).data;
          }

          function speaksOnThis() {
            return signedIn() && uid() in proposal().speakerIds;
          }

          // Nothing to score on a draft nobody submitted, or on one its author
          // took back. Without this a review could be attached to either, and
          // would then count towards the aggregate.
          function scorable() {
            return proposal().status != 'draft' && proposal().status != 'withdrawn';
          }

          function ownReview() {
            return isReviewer(cfpId) && reviewerUid == uid() && !speaksOnThis();
          }

          allow get: if !speaksOnThis()
            && (ownReview()
                || (isReviewer(cfpId) && cfp(cfpId).reviewsVisible == true)
                || isAdmin(cfpId));
          allow list: if !speaksOnThis()
            && ((isReviewer(cfpId) && cfp(cfpId).reviewsVisible == true) || isAdmin(cfpId));

          // Each reviewer writes only their own document, so nobody can
          // overwrite a colleague's score.
          //
          // `cfpId` is pinned to the path for the same reason as on the
          // proposal: `recomputeAggregates` reaches these through a
          // collection-group query, which cannot be filtered by ancestor, so a
          // review claiming another CFP would land in that CFP's totals.
          // `hasOnly` is what makes the comment cap below mean anything. Without
          // it the same text goes in under any other key — nothing would read it,
          // but nothing would bound it either, and a document nobody polices is
          // not a document anybody can reason about. These five are exactly what
          // `saveReview` writes.
          allow create, update: if ownReview()
            && scorable()
            && !archived(cfpId)
            && request.resource.data.keys()
                 .hasOnly(['cfpId', 'score', 'conflictOfInterest', 'comment', 'updatedAt'])
            && request.resource.data.get('cfpId', '') == cfpId
            && request.resource.data.score is int
            && request.resource.data.score >= 1
            && request.resource.data.score <= 4
            && request.resource.data.conflictOfInterest is bool
            // 2000 is LIMITS.reviewCommentMax. Rules cannot import it, so the two
            // are pinned together by tests/reviewComment.test.ts.
            && (!('comment' in request.resource.data)
                || (request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 2000));

          allow delete: if false;
        }
      }

      // -------------------------------------------------------- email log

      // Written by the email pipeline (admin SDK) only. Contains applicant
      // addresses, so it is not client-readable at all.
      match /emailLog/{logId} {
        allow read, write: if false;
      }
    }

    // --------------------------------------------------- every CFP I am on
    //
    // The one query that deliberately spans tenants, and it returns only the
    // caller's own membership documents:
    // `collectionGroup('members').where('uid','==',uid)`.
    //
    // Matched on the field rather than on `{memberUid}`, even though the two
    // hold the same value. A collection-group query does not bind the path
    // wildcard the way a document read does, so the id comparison is denied for
    // every document — which is why `uid` is denormalised onto the member.
    match /{path=**}/members/{memberUid} {
      allow list: if signedIn() && resource.data.uid == uid();
    }

    // --------------------------------------------------------------- speakers

    // Global, because a profile belongs to the account rather than to any one
    // talk — nobody should retype their bio for every CFP they apply to.
    //
    // Which is exactly why nobody else may read it. A role is per CFP; a
    // profile is not, so "reviewers may read speakers" would hand every
    // committee on the platform the whole directory. The committee reads
    // `speakerSnapshot` on the proposal instead, which is scoped to their own
    // CFP and frozen at the moment they were asked to judge it.
    match /speakers/{speakerId} {
      function ownProfile() {
        return signedIn() && speakerId == uid();
      }

      allow get, list: if ownProfile();

      allow create: if ownProfile()
        && request.resource.data.email == request.auth.token.email;
      allow update: if ownProfile()
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // --------------------------------------------------------- sign-in links

    // How many links an address has asked for lately. Platform-wide rather than
    // per CFP: the throttle protects the sending domain's reputation, which is
    // one thing however many CFPs are running. Nobody signs in to read it, and
    // its contents would say who has been trying to.
    match /signInLinks/{hash} {
      allow read, write: if false;
    }

    // ------------------------------------------------------- platform config

    // `config/platform` holds the site's own URL, which only the functions need
    // in order to build links. Nothing here is client-readable.
    match /config/{docId} {
      allow read, write: if false;
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
