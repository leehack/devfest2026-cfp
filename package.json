{
  "name": "devfest-mtl-2026-cfp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "emulators": "firebase emulators:start --only auth,firestore,functions,hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "test": "vitest run tests/aggregate.test.ts tests/sessionize.test.ts tests/formState.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-devfest-cfp \"vitest run tests/rules.test.ts\""
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.24.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
