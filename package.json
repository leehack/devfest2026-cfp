{
  "name": "devfest-mtl-2026-cfp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p functions/tsconfig.json --noEmit",
    "emulators": "npx firebase emulators:start --only auth,firestore,functions,storage --project demo-devfest-cfp",
    "deploy:app": "npx firebase deploy --only apphosting --project devfest-mtl-2026-cfp",
    "deploy:functions": "npx firebase deploy --only functions --project devfest-mtl-2026-cfp",
    "deploy:backend": "npx firebase deploy --only functions,firestore,storage --project devfest-mtl-2026-cfp",
    "deploy:rules": "npx firebase deploy --only firestore:rules,firestore:indexes,storage --project devfest-mtl-2026-cfp",
    "test": "vitest run --project unit",
    "test:rules": "node scripts/with-java.mjs npx firebase emulators:exec --only firestore,storage --project demo-devfest-cfp \"vitest run --project rules\"",
    "lint": "eslint .",
    "migrate:organization": "node scripts/migrate-single-cfp-to-org.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run check:bundle && npm test && npm run test:rules && npm run test:e2e",
    "start": "node scripts/dev.mjs",
    "test:e2e": "playwright test",
    "test:e2e:changed": "playwright test --only-changed --pass-with-no-tests",
    "test:e2e:failed": "playwright test --last-failed --pass-with-no-tests",
    "start:next": "next start",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.32.0",
    "globals": "^17.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "minimatch@<4": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@>=4 <10": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@>=10": {
      "brace-expansion": "5.0.9"
    },
    "gaxios@<7": {
      "uuid": "11.1.1"
    },
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    },
    "teeny-request": {
      "uuid": "11.1.1"
    }
  }
}
