{
  "name": "devfest-mtl-2026-cfp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p functions/tsconfig.json --noEmit",
    "emulators": "npx firebase emulators:start --only auth,firestore,functions,storage --project demo-devfest-cfp",
    "deploy:app": "npx firebase deploy --only apphosting --project devfest-mtl-2026-cfp",
    "deploy:backend": "npx firebase deploy --only functions,firestore,storage --project devfest-mtl-2026-cfp",
    "deploy:rules": "npx firebase deploy --only firestore:rules,firestore:indexes,storage --project devfest-mtl-2026-cfp",
    "test": "vitest run --project unit",
    "test:rules": "node scripts/with-java.mjs npx firebase emulators:exec --only firestore,storage --project demo-devfest-cfp \"vitest run --project rules\"",
    "lint": "eslint .",
    "smoke:production": "node scripts/smoke-production.mjs",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run check:bundle && npm test && npm run test:rules && npm run test:e2e",
    "start": "node scripts/dev.mjs",
    "test:e2e": "playwright test",
    "start:next": "next start",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "firebase-admin": "^14.2.0",
    "next": "^16.2.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-tools": "^15.24.0",
    "globals": "^17.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25"
    }
  }
}
