{
  "name": "devfest-mtl-2026-cfp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "emulators": "firebase emulators:start --only auth,firestore,functions,hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "test": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-devfest-cfp \"vitest run --project rules\"",
    "lint": "eslint .",
    "verify": "npm run lint && npm run build && npm test && npm run test:rules && npm run test:e2e",
    "start": "node scripts/dev.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.62.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.24.0",
    "globals": "^17.8.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
