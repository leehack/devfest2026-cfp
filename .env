# Committed on purpose: emulator placeholders so `npm run dev` works out of the box.
# Local development against the Firebase emulator suite.
#
# A projectId beginning with "demo-" tells the emulators not to expect real
# credentials, so these values are placeholders on purpose. For a manual
# production build, copy .env.example to .env.production.local and fill that in
# from the console. Never replace this file or local development may hit live
# Firebase services.

NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-devfest-cfp.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-devfest-cfp
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-devfest-cfp.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Google Analytics. Absent here on purpose: with no id the analytics module is
# inert and the consent banner does not render, which is what local development
# and anyone else running this platform should get. Set it in
# .env.production.local once GA4 is linked to the Firebase project.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

NEXT_PUBLIC_COC_URL=https://gdgmontreal.com/code-of-conduct

NEXT_PUBLIC_USE_EMULATORS=true
