# Committed on purpose: emulator placeholders so `npm run dev` works out of the box.
# Local development against the Firebase emulator suite.
#
# A projectId beginning with "demo-" tells the emulators not to expect real
# credentials, so these values are placeholders on purpose. Copy .env.example
# and fill in the real ones from the console when you point this at a project.

VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-devfest-cfp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-devfest-cfp
VITE_FIREBASE_STORAGE_BUCKET=demo-devfest-cfp.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

VITE_COC_URL=

VITE_USE_EMULATORS=true
