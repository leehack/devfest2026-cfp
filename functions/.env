# Non-secret settings, read by functions/src/email.ts.
#
# The sending address normally lives in `config/email` and is set from #/admin;
# these are the fallback for a project that has never had one set. Empty means
# dry-run: every message renders and records `dry_run` on its emailLog row, and
# nothing is sent.
#
# THIS FILE IS DEPLOYED. It is tracked, and `firebase deploy` ships it as the
# functions' runtime environment — so a value that is only right on a laptop is
# wrong in production. A localhost CFP_PUBLIC_URL lived here once and went out
# in a real acceptance email as the link the speaker was asked to confirm at.
# Local-only values belong in `.env.local`, which is gitignored and which the
# emulator reads and deploy ignores.
CFP_EMAIL_FROM=
CFP_REPLY_TO=
CFP_PUBLIC_URL=
