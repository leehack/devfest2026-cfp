# Non-secret settings, read by functions/src/email.ts.
#
# The sending address normally lives in `config/email` and is set from #/admin;
# these are the fallback for a project that has never had one set. Empty means
# dry-run: every message renders and records `dry_run` on its emailLog row, and
# nothing is sent. Leave them empty here — this file is the local stack.
CFP_EMAIL_FROM=
CFP_REPLY_TO=
CFP_PUBLIC_URL=http://localhost:5173
