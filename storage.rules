rules_version = '2';

// Speaker photos, and nothing else. Reusable profile originals stay private;
// confirmation freezes exact event copies, and public schedule derivatives are
// still served only through a release-membership-checking callable.
service firebase.storage {
  match /b/{bucket}/o {

    // Upload and preview callables derive every path after checking Firestore.
    // A browser cannot take the CFP's external-mutation lease, and a download
    // URL would be a bearer credential, so the whole bucket stays closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
