rules_version = '2';

// Headshots, and nothing else.
//
// Collected after acceptance (§3), so the bucket holds objects for the handful
// of speakers on each programme rather than for every applicant — which is both
// the storage bill and the thing that would leak if this file were wrong.
service firebase.storage {
  match /b/{bucket}/o {

    // Upload and preview callables derive every path after checking Firestore.
    // A browser cannot take the CFP's external-mutation lease, and a download
    // URL would be a bearer credential, so the whole bucket stays closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
