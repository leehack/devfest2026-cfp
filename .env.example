# For a manual production build, copy this to .env.production.local and fill it
# in from the Firebase console (Project settings > General). Never overwrite the
# tracked .env: it deliberately keeps local development on the emulator project.
#
# These values are shipped to the browser and are not secrets — Firebase web API
# keys identify the project, they do not authorise anything. Access control is
# firestore.rules, which is why §6 calls those rules non-negotiable.
#
# NEXT_PUBLIC_ is load-bearing: Next only inlines a variable into the client
# bundle if the name starts with it, and only where `process.env.NEXT_PUBLIC_X` is
# written out in full. See src/lib/env.ts.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional. When absent, analytics is inert and no consent banner is shown.
# When set, the Analytics SDK still loads only after the visitor opts in.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Absolute HTTPS link rendered next to the Code of Conduct checkbox. Production
# builds refuse to continue without it: speakers must be able to open the policy
# they are accepting.
NEXT_PUBLIC_COC_URL=

# Set to "true" to point the app at the local emulator suite. A production build
# refuses to start with this on; see next.config.ts.
NEXT_PUBLIC_USE_EMULATORS=false

# Absolute HTTPS origin where the deployment answers, for the canonical tag and
# the sitemap. Server-side only, so no NEXT_PUBLIC_ prefix. Must agree with
# config/platform.publicUrl, which is what the functions build mailed links from.
SITE_ORIGIN=
SITE_NAME=
