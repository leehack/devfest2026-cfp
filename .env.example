# Copy to .env and fill in from the Firebase console (Project settings > General).
#
# These values are shipped to the browser and are not secrets — Firebase web API
# keys identify the project, they do not authorise anything. Access control is
# firestore.rules, which is why §6 calls those rules non-negotiable.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Link rendered next to the Code of Conduct checkbox. Omit and the checkbox
# renders without a link.
VITE_COC_URL=

# Set to "true" to point the app at the local emulator suite.
VITE_USE_EMULATORS=false
